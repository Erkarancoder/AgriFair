# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/agrifair

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_DAYS=7

# Email / SMTP Delivery Service (Optional: for real email OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="AgriFair Marketplace" <no-reply@agrifair.org>

# Official Government of India Mandi Data (AGMARKNET via data.gov.in)
# Register at https://data.gov.in to acquire your personal API key
DATAGOV_API_KEY=your_datagov_api_key_here
DATAGOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATAGOV_BASE_URL=https://api.data.gov.in/resource

# Real Product Image Storage (Cloudinary)
# Register at https://cloudinary.com for free cloud media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Real Razorpay Payment Gateway (Phase 6D)
# Sign up at https://dashboard.razorpay.com to obtain Test Mode API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

